# Neon PostgreSQL — use a NEW dedicated database, not the PPA/LoPiPo one
DATABASE_URL="postgresql://user:pass@host/khada_pathway?sslmode=require"
# Simple shared secret for the navigator dashboard until real auth is added
NAVIGATOR_KEY="change-me"

# --- Eksplike lèt mwen (explain my letter) ---
