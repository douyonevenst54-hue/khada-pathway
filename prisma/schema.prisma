generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Deliberately minimal. No name, no immigration status, no income figures.
model Session {
  id        String       @id @default(cuid())
  pathwayId String
  lang      String       @default("ht")
  zip       String
  answers   Json
  planKeys  String[]
  contact   String?
  createdAt DateTime     @default(now())
  steps     StepStatus[]

  @@index([pathwayId, createdAt])
}

model StepStatus {
  id        String   @id @default(cuid())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  stepKey   String
  status    String
  note      String?
  updatedAt DateTime @updatedAt

  @@unique([sessionId, stepKey])
}

model FollowUp {
  id        String    @id @default(cuid())
  sessionId String
  dueAt     DateTime
  doneAt    DateTime?
  outcome   String?

  @@index([dueAt])
}// ---- Append these two models to the end of prisma/schema.prisma ----

model Navigator {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model LoginToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
}

// "Eksplike lèt mwen" — one row per letter explained, for navigator review.
// Never stores the photo, the letter text, the person's free-text note, or ID numbers.
model LetterReview {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  lang       String    @default("ht")
  sender     String
  letterType String
  urgency    String // high | medium | low
  deadline   String?
  deadlineDate DateTime? @db.Date // parsed deadline, for reminders
  deadlineNote String? // what to do by then, in the person's language
  summaryEn  String
  summaryHt  String
  nextSteps  Json // string[] in Creole, as shown to the person
  unclear    Boolean   @default(false)
  redFlag    Boolean   @default(false)
  contact    String? // optional phone the person chose to leave
  status     String    @default("open") // open | done
  reviewedAt DateTime?
  reviewedBy String?
  reviewNote String?

  @@index([status, createdAt])
}

// "Fè m sonje" — WhatsApp reminders a navigator sends with one tap from /navigator.
// kind "before": 7 days before the deadline. kind "after": 1 day after, to check it got done.
model Reminder {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  reviewId  String
  kind      String // before | after
  phone     String // digits with country code, e.g. 17815551234
  lang      String    @default("ht")
  sender    String
  deadline  DateTime  @db.Date
  note      String?
  remindAt  DateTime
  status    String    @default("pending") // pending | sent | cancelled
  sentAt    DateTime?
  sentBy    String?
  outcome   String? // after-check: done | help | no_answer

  @@unique([reviewId, kind])
  @@index([status, remindAt])
}
